{{> menu id="about"}}

<section class="ui left aligned middle aligned segment">

  <h2>About the Playlist App</h2>
  <p>
    More information about the app
  </p>


<div class="ui centered card">
  <div class="image">
    <img src="{{cards.stevie}}">
  </div>
  <div class="content">
    <a class="header">{{cards.fullname}}</a>
    <div class="meta">
      <span class="date">Joined in {{cards.joined}}</span>
    </div>
    <div class="description">
      {{cards.name}} is an {{cards.job}} living in {{cards.city}}.
    </div>
  </div>
  <div class="extra content">
    <a>
      <i class="user icon"></i>
      {{cards.mates}} contacts
    </a>
  </div>
</div>

</section>
